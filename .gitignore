# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
# S-D5: PyInstaller auto-writes this beside the entry point it's given
# (scripts/freeze.py's own invocation) -- a regenerated build artifact,
# same reasoning as build/dist above, and it embeds an absolute machine
# path (P-2) so it must never be committed.
/vantage.spec

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Conan local
conaninfo.txt
conanbuildinfo.*
conan.lock
# Conan-generated, machine-specific (regenerated by every conan install)
CMakeUserPresets.json

# WP-03: src/simcore is a real compiled target now -- local CMake/MSVC
# build outputs (do not ignore src/simcore, src/simengine, include/simcore).
build-*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
CTestTestfile.cmake
Testing/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.opensdf
*.sdf
x64/
Win32/
Release/
Debug/
