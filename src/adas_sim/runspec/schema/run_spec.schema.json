{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adas-sim/run_spec.schema.json",
  "title": "adas-sim Resolved Run Spec (IF-09, design doc SS3.1)",
  "description": "The seam between the Python config layer and simcore (schema adas.sim.runspec/2.0). Every reference resolved, every path absolute, every port carrying a concrete record, bulk and buffer_depth -- if the engine has to decide something the configuration layer could have decided, the spec is missing a field (design SS3.3). The keys are exactly those of VANTAGE_Architecture.md section 2.3; the loader (simcore::LoadRunSpec) refuses any other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "spec_sha256", "sources", "stages", "mutations", "coherence_verdict", "outputs", "limits", "readiness_limit_steps", "fallback_max_gap"],
  "properties": {
    "schema": {"const": "adas.sim.runspec/2.0"},
    "run_id": {"type": "string"},
    "spec_sha256": {"type": "string"},
    "readiness_limit_steps": {"type": "integer"},
    "fallback_max_gap": {"type": "integer"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "codec", "ingest", "absent"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "codec": {"type": "string"},
          "ingest": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["raw_topic", "port", "origin", "proto_type", "factor", "offset"],
              "properties": {
                "raw_topic": {"type": "string"},
                "port": {"type": "string"},
                "origin": {"type": "string"},
                "proto_type": {"type": "string"},
                "factor": {"type": "number"},
                "offset": {"type": "number"}
              }
            }
          },
          "absent": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["port", "reason"],
              "properties": {"port": {"type": "string"}, "reason": {"type": "string"}}
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "mode", "impl", "trigger", "clock_period_ns", "abi_version", "config_bundle_sha256", "ports", "inputs"],
        "properties": {
          "name": {"type": "string"},
          "mode": {"enum": ["simulate", "measured", "off"]},
          "impl": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "path", "pattern", "search"],
            "properties": {
              "kind": {"enum": ["dll", "stubdll"]},
              "path": {"type": "string"},
              "pattern": {"type": "string"},
              "search": {"type": "array", "items": {"type": "string"}}
            }
          },
          "trigger": {"type": "string"},
          "clock_period_ns": {"type": "integer", "minimum": 0},
          "abi_version": {"type": "integer"},
          "config_bundle_sha256": {"type": "string"},
          "ports": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "dir", "kind", "proto_type", "record", "fixed_slots", "bulk", "buffer_depth"],
              "properties": {
                "name": {"type": "string"},
                "dir": {"enum": ["pro", "req"]},
                "kind": {"enum": ["data"]},
                "proto_type": {"type": "string"},
                "record": {"type": "string"},
                "fixed_slots": {"type": ["boolean", "null"]},
                "bulk": {"type": "boolean"},
                "buffer_depth": {"type": "integer"}
              }
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["port", "producer", "producer_port", "previous_cycle"],
              "properties": {
                "port": {"type": "string"},
                "producer": {"type": "string"},
                "producer_port": {"type": "string"},
                "previous_cycle": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["verb", "address", "operands", "window_ns"],
        "properties": {
          "verb": {"enum": ["const", "hold", "offset", "scale", "select", "drop"]},
          "address": {
            "type": "object", "additionalProperties": false,
            "required": ["stage", "port", "path", "index"],
            "properties": {
              "stage": {"type": "string"},
              "port": {"type": "string"},
              "path": {"type": "array", "items": {"type": "string"}},
              "index": {"anyOf": [{"type": "integer"}, {"const": "*"}, {"type": "null"}]}
            }
          },
          "operands": {"type": "array", "items": {"type": "number"}},
          "window_ns": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": ["integer", "null"]}
          }
        }
      }
    },
    "coherence_verdict": {"type": "string"},
    "outputs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "codec": {"type": "string"},
        "livemeas": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "cycle_slot_count", "cycle_slot_size", "bulk_slot_count", "bulk_slot_size"],
          "properties": {
            "name": {"type": "string"},
            "cycle_slot_count": {"type": "integer"},
            "cycle_slot_size": {"type": "integer"},
            "bulk_slot_count": {"type": "integer"},
            "bulk_slot_size": {"type": "integer"}
          }
        }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "properties": {"path": {"type": "string"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["exec_timeout_ms", "severity_exit"],
      "properties": {
        "exec_timeout_ms": {"type": "integer", "minimum": 0},
        "severity_exit": {"type": "string"}
      }
    }
  }
}
